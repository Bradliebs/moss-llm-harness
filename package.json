{
  "name": "moss",
  "version": "0.1.0",
  "description": "Standalone agentic desktop harness for Ollama, OpenAI-compatible, and Anthropic providers",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:deterministic": "vitest run --exclude electron/ipc/chat-ipc.e2e.test.ts",
    "test:coverage": "vitest run --coverage --exclude electron/ipc/chat-ipc.e2e.test.ts",
    "lint": "eslint eslint.config.mjs src/components/AutomationSettings.tsx src/components/LiveStatus.tsx src/components/ProductDiagnosticsSettings.tsx src/components/RunCenter.tsx src/components/ToolActivity.tsx src/lib/missionTemplates.ts src/lib/taskRuns.ts electron/backend/moss/product-diagnostics.ts electron/backend/moss/evals/product-metrics.ts electron/backend/moss/evals/product-ux-cases.ts scripts/check-bundle-budget.mjs scripts/smoke-packaged.mjs --max-warnings=0",
    "test:sandbox": "node scripts/test-sandbox.cjs",
    "eval": "npm run build:main --silent && node dist-electron/electron/backend/moss/evals/eval-cli.js",
    "eval:health": "npm run eval -- health scripts/eval-pilots.cjs",
    "start": "electron .",
    "dev:renderer": "vite",
    "dev": "npm run build:main && npm run build:renderer && electron .",
    "pack": "npm run build && electron-builder --dir",
    "pack:ci": "electron-builder --dir --config.win.signAndEditExecutable=false",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "eventsource-parser": "^3.1.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^42.5.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  }
}
